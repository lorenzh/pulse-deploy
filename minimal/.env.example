# Variables of minimal/compose.yaml. Copy to minimal/.env and uncomment a line to change it.
# There is no token here: run scripts/init-secrets.sh, it writes secrets/probe-token.

# Host directory with probe-token (mode 0600), relative to minimal/. Never created by Compose.
# PULSE_SECRETS_DIR=../secrets
# Location of the probe; also the location of its token in the api's tokens.json.
# PULSE_LOCATION=default
# Host port of the api, always bound to 127.0.0.1.
# PULSE_API_PORT=3000
