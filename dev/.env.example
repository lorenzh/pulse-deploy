# Variables of dev/compose.yaml. Copy to dev/.env and uncomment a line to change it.
# There is no token here: run scripts/init-secrets.sh, it writes secrets/probe-token.

# Directory that holds the checkouts pulse-api, pulse-probe, pulse-status, pulse-notify and
# pulse-console, relative to dev/. The default is the directory that holds pulse-deploy.
# PULSE_SRC_DIR=../..
# Host directory with probe-token (mode 0600), relative to dev/. Never created by Compose.
# PULSE_SECRETS_DIR=../secrets
# Location of the probe; also the location of its token in the api's tokens.json.
# PULSE_LOCATION=default
# Host port of the api, always bound to 127.0.0.1.
# PULSE_API_PORT=3000
# Host port of the status page, on all interfaces.
# PULSE_STATUS_PORT=8080
# Host port of the console, always bound to 127.0.0.1.
# PULSE_CONSOLE_PORT=8082
# Public origin of the console behind a TLS reverse proxy, e.g. https://console.example.com.
# Empty: loopback mode on http://127.0.0.1:<PULSE_CONSOLE_PORT>.
# PULSE_CONSOLE_PUBLIC_URL=
