# Variables of full/compose.yaml. Copy to full/.env and uncomment a line to change it.
# There is no token here: run scripts/init-secrets.sh, it writes secrets/probe-token.

# Host directory with probe-token (mode 0600), relative to full/. Never created by Compose.
# PULSE_SECRETS_DIR=../secrets
# Location of the probe; also the location of its token in the api's tokens.json.
# PULSE_LOCATION=default
# Host port of the status page, on all interfaces.
# PULSE_STATUS_PORT=8080
# Host port of the console, always bound to 127.0.0.1.
# PULSE_CONSOLE_PORT=8082
