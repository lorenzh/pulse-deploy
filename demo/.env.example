# Variables of demo/compose.yaml. The demo needs no .env; copy to demo/.env only to change a port.
# The demo has no token to set: secrets-init generates one per location at start.

# Host port of the status page, bound to 127.0.0.1.
# PULSE_STATUS_PORT=8080
# Host port of the console, bound to 127.0.0.1.
# PULSE_CONSOLE_PORT=8082
# Host port of the mailpit UI and API, bound to 127.0.0.1.
# PULSE_MAILPIT_PORT=8025
